<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>MiCake.Templates</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>MiCake Project Templates</Title>
    <Authors>MiCake Team</Authors>
    <Description>Production-ready project templates for MiCake DDD framework. Create high-quality ASP.NET Core applications following Domain-Driven Design principles.</Description>
    <PackageTags>dotnet-new;templates;micake;ddd;domain-driven-design;aspnetcore;webapi</PackageTags>
    <PackageProjectUrl>https://github.com/MiCake/MiCake.Templates</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/MiCake/MiCake.Templates.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- Template package settings -->
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Include all template content, excluding build artifacts -->
    <Content Include="src/**/*" Exclude="src/**/bin/**;src/**/obj/**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- Exclude all C# compilation -->
    <Compile Remove="**/*" />
  </ItemGroup>
</Project>
